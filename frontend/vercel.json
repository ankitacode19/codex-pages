{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_API_URL": "@codex_pages_api_url",
    "VITE_SUPABASE_URL": "@codex_pages_supabase_url",
    "VITE_SUPABASE_ANON_KEY": "@codex_pages_supabase_anon_key"
  }
}
